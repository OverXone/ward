{
  "name": "ward",
  "private": true,
  "version": "0.2.0",
  "description": "Control the League of Legends client from your phone over your local Wi-Fi.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "connector",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w connector --",
    "events": "npm run events -w connector --",
    "mock-lcu": "npm run mock-lcu -w connector --",
    "smoke": "npm run smoke -w connector --",
    "api-list": "npm run api-list -w connector --",
